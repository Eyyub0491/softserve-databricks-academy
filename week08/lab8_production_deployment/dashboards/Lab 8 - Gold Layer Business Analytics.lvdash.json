{
  "datasets": [
    {
      "name": "daily_sales",
      "displayName": "Daily Sales Data",
      "config": {
        "version": "1.1",
        "source": "lab5.gold.agg_daily_sales",
        "dimensions": [
          {
            "name": "order_date",
            "expr": "order_date"
          }
        ],
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(total_revenue)"
          },
          {
            "name": "total_orders",
            "expr": "SUM(total_orders)"
          },
          {
            "name": "total_quantity",
            "expr": "SUM(total_quantity)"
          },
          {
            "name": "avg_order_value",
            "expr": "SUM(total_revenue) * 1.0 / NULLIF(SUM(total_orders), 0)"
          }
        ]
      }
    },
    {
      "name": "customer_summary",
      "displayName": "Customer Summary Data",
      "config": {
        "version": "1.1",
        "source": "lab5.gold.agg_customer_summary",
        "dimensions": [
          {
            "name": "customer_id",
            "expr": "customer_id"
          },
          {
            "name": "customer_name",
            "expr": "customer_name"
          },
          {
            "name": "state",
            "expr": "state"
          },
          {
            "name": "loyalty_segment_name",
            "expr": "loyalty_segment_name"
          }
        ],
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(total_revenue)"
          },
          {
            "name": "total_orders",
            "expr": "SUM(total_orders)"
          },
          {
            "name": "total_quantity",
            "expr": "SUM(total_quantity)"
          },
          {
            "name": "customer_count",
            "expr": "COUNT(DISTINCT customer_id)"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "business_overview",
      "displayName": "Business Overview",
      "layout": [
        {
          "widget": {
            "name": "total_revenue",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "daily_sales",
                  "fields": [
                    {
                      "name": "measure(total_revenue)",
                      "expression": "MEASURE(`total_revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "title": "Total Revenue",
                "showTitle": true
              },
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(total_revenue)",
                  "rowNumber": 0,
                  "format": {
                    "type": "number-plain",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 1
                    }
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 3,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "total_orders",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "daily_sales",
                  "fields": [
                    {
                      "name": "measure(total_orders)",
                      "expression": "MEASURE(`total_orders`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "title": "Total Orders",
                "showTitle": true
              },
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(total_orders)",
                  "rowNumber": 0,
                  "format": {
                    "type": "number-plain",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 1
                    }
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 3,
            "y": 0,
            "width": 3,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "total_customers",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "customer_summary",
                  "fields": [
                    {
                      "name": "measure(customer_count)",
                      "expression": "MEASURE(`customer_count`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "title": "Total Customers",
                "showTitle": true
              },
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(customer_count)",
                  "rowNumber": 0,
                  "format": {
                    "type": "number-plain",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 1
                    }
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 0,
            "width": 3,
            "height": 2
          }
        }
      ]
    }
  ],
  "displayName": "Lab 8 - Gold Layer Business Analytics"
}
